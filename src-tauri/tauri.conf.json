{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reconsile",
  "version": "0.1.0",
  "identifier": "com.axount.reconsile",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reconsile",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["recon"],
        "name": "Reconsile Project",
        "description": "Reconsile project",
        "mimeType": "application/vnd.axount.reconsile-project",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": {
          "identifier": "com.axount.reconsile.project",
          "conformsTo": ["public.data"]
        }
      }
    ]
  }
}
